{
  "subPackages": [
    {
      "root": "tendencyPages/"
    },
    {
      "root": "userPages/"
    },
    {
      "root": "otherPages/"
    }
  ],
  "entryPagePath": "pages/tendency/tendency.html",
  "pages": [
    "pages/tendency/tendency",
    "pages/collection/collection",
    "pages/user/user",
    "tendencyPages/unPay/unPay",
    "userPages/myInvitation/myInvitation",
    "userPages/myInformation/myInformation",
    "userPages/myInterests/myInterests",
    "userPages/myDeduction/myDeduction",
    "userPages/couponList/couponList",
    "userPages/myOrder/myOrder",
    "userPages/myApiKey/myApiKey",
    "otherPages/webView/webView"
  ],
  "page": {
    "pages/tendency/tendency.html": {
      "window": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "趋势",
        "enablePullDownRefresh": false
      }
    },
    "pages/collection/collection.html": {
      "window": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "收藏夹",
        "enablePullDownRefresh": false
      }
    },
    "pages/user/user.html": {
      "window": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "我的",
        "enablePullDownRefresh": false
      }
    },
    "tendencyPages/unPay/unPay.html": {
      "window": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "二级页面",
        "enablePullDownRefresh": false
      }
    },
    "userPages/myInvitation/myInvitation.html": {
      "window": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "邀请与分享",
        "enablePullDownRefresh": false
      }
    },
    "userPages/myInformation/myInformation.html": {
      "window": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "个人信息",
        "enablePullDownRefresh": false
      }
    },
    "userPages/myInterests/myInterests.html": {
      "window": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "我的权益",
        "enablePullDownRefresh": false
      }
    },
    "userPages/myDeduction/myDeduction.html": {
      "window": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "我的抵扣券",
        "enablePullDownRefresh": false
      }
    },
    "userPages/couponList/couponList.html": {
      "window": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "抵扣券列表",
        "enablePullDownRefresh": false
      }
    },
    "userPages/myOrder/myOrder.html": {
      "window": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "我的订单",
        "enablePullDownRefresh": false
      }
    },
    "userPages/myApiKey/myApiKey.html": {
      "window": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "我的ApiKey",
        "enablePullDownRefresh": false
      }
    },
    "otherPages/webView/webView.html": {
      "window": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "趋势动物Pro",
        "enablePullDownRefresh": false
      }
    }
  },
  "permission": {
    "scope.userLocation": {
      "desc": "你的位置信息将用于小程序位置接口的效果展示。"
    }
  },
  "global": {
    "window": {
      "navigationBarTextStyle": "white",
      "navigationBarTitleText": "趋势动物Pro",
      "backgroundColor": "#29282e",
      "backgroundColorBottom": "#29282e",
      "backgroundColorTop": "#29282e"
    }
  },
  "tabBar": {
    "height": "120rpx",
    "iconWidth": "60rpx",
    "color": "#7F8389",
    "backgroundColor": "#29282e",
    "selectedColor": "#ffffff",
    "custom": true,
    "list": [
      {
        "text": "趋势",
        "pagePath": "pages/tendency/tendency.html",
        "iconData": "",
        "selectedIconData": ""
      },
      {
        "text": "收藏夹",
        "pagePath": "pages/collection/collection.html",
        "iconData": "",
        "selectedIconData": ""
      },
      {
        "text": "我的",
        "pagePath": "pages/user/user.html",
        "iconData": "",
        "selectedIconData": ""
      }
    ]
  },
  "resizable": false,
  "preloadRule": {
    "pages/tendency/tendency": {
      "network": "all",
      "packages": ["tendencyPages"]
    },
    "pages/user/user": {
      "network": "all",
      "packages": ["userPages", "otherPages"]
    }
  },
  "frameset": false,
  "renderer": {
    "allUsed": ["webview"],
    "default": "webview"
  },
  "requiredPrivateInfos": ["getLocation", "chooseLocation"],
  "componentFramework": {
    "allUsed": ["exparser"],
    "default": "exparser"
  }
}
